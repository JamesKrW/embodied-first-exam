COPY . /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:standard-files-0.4.0-nosignal@sha256:9d9eb71b2baafac8d8a7975a78cca8e0e4f4ffd0aab700ed137653aa5f4e59d5 /rcb1.py /srv/rcb1.py
COPY --from=ghcr.io/mll-lab-nu/efe:robotwin-2-files-0.3.0-nosignal@sha256:3c9fc4b34d62af292c6f0bd99a9e4f1be592634a68875434e0f6f416c141fe6b \
     /sim/rcb_live.py \
     /sim/server.py \
     /srv/
