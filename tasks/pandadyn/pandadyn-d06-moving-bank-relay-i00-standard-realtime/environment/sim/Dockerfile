     /rcb1.py \
     /realtime/rcb_realtime.py \
     /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:pandadyn-files-0.4.0-stateq@sha256:0e3040f17793b580799dc932a9438e070f7d5f6769305b381fb2505403224126 \
     /privileged/environment/rcb_pandadyn.py \
     /sim/rcb_service.py \
     /sim/variants/727bef3b2d/server.py \
     /srv/
