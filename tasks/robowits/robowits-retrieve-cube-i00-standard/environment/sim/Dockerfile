     /rcb1.py \
     /rcb_limited.py \
     /run.sh \
     /srv/
COPY --from=ghcr.io/mll-lab-nu/efe:robowits-files-0.4.0-nosignal@sha256:54198944e1e9c611b9536b9f504c302b2eb4362d0b266d36ef113291858c624a \
     /privileged/tests/rcb_robowits.py \
     /sim/server.py \
     /srv/
