COPY --from=ghcr.io/mll-lab-nu/efe:humanoidbench-files-0.4.0@sha256:bd87b30f7fcfbc1343e3ef24af0a40a58b349146e2ceb47e2eb00eb64ac9ff2d \
     /privileged/environment/rcb_hb.py \
     /privileged/tests/rcb_rewards.py \
     /sim/rcb_service.py \
     /sim/server.py \
     /srv/
